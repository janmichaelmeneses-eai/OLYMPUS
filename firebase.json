{
  "functions": [{ "source": "functions", "codebase": "olympus", "runtime": "nodejs22", "ignore": ["node_modules", ".git", "test", "*.log"], "predeploy": ["npm --prefix \"$RESOURCE_DIR\" test"] }],
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-cache" }
      ] }
    ]
  },
  "firestore": { "rules": "firestore.rules" },
  "emulators": { "auth": { "port": 9099 }, "functions": { "port": 5001 }, "firestore": { "port": 8080 }, "hosting": { "port": 5000 } }
}
